# Copy this file to .env.local and fill in real values.
# cp .env.example .env.local

# MongoDB Atlas connection string
MONGODB_URI=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Dedicated key for encrypting payment-gateway credentials at rest (Settings →
# Payment Methods). Falls back to NEXTAUTH_SECRET if unset, but set your own
# stable value in production — any 32+ character random string works:
#   openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# SSLCommerz (payment gateway - Bangladesh)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ---- Transactional email (order confirmations, status updates, refunds) ----
# Optional: these are a fallback only. Settings → Email Notifications in the
# admin panel takes priority once configured there (and stores the password
# encrypted). Leave blank to run with in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ---- Digital download links ----
# Signs the short-lived tokens that authorise a file download. Optional: if
# left blank, NEXTAUTH_SECRET is used instead. Setting a dedicated secret
# means you can invalidate every outstanding download link (by changing it)
# without signing every customer out.
# Generate one with:  openssl rand -base64 32
DOWNLOAD_SIGNING_SECRET=

# ---- Abandoned basket reminders ----
# The bearer token a scheduler presents to POST /api/admin/carts/sweep, which
# sends the reminders that are due. Leave it blank and the scheduled route is
# closed completely — staff can still send reminders from Admin → Abandoned
# Baskets, but nothing runs automatically. It is never "open when unset".
# Generate one with:  openssl rand -base64 32
CART_SWEEP_SECRET=

# ---- SMS (order updates by text) ----
# There is no environment variable for the SMS gateway: it is configured in
# Admin → Settings → Notifications, where the API key is stored encrypted.
# Most Bangladeshi bulk-SMS providers take a single HTTP request, which that
# page lets you paste in with {to} and {text} placeholders. Use the "Send a
# test" button there to confirm it works before customers depend on it.

# ---- bKash (testing only) ----
# Points the bKash SANDBOX at a different host — a local stub, or a sandbox
# URL bKash gave you. Live mode ignores this completely and always talks to
# bKash's own host, so this can never divert a real payment. Leave empty.
BKASH_API_BASE=
